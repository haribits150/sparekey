{"rules":{"circles":{"$circleId":{".read":"auth != null && (!data.exists() || root.child('circles').child($circleId).child('members').child(auth.uid).exists())",".write":"auth != null && (!data.exists() || root.child('circles').child($circleId).child('members').child(auth.uid).exists())","members":{"$uid":{".write":"auth != null && auth.uid == $uid && !data.exists()"}}}},"invites":{"$code":{".read":"auth != null",".write":"auth != null && (!data.exists() || data.child('createdBy').val() == auth.uid)"}},"users":{"$uid":{".read":"auth != null && auth.uid == $uid",".write":"auth != null && auth.uid == $uid"}}}}